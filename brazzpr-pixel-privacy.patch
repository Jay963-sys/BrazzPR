+"use client";
+
+import Link from "next/link";
+import { useEffect, useState } from "react";
+import { getConsent, setConsent } from "../../lib/pixel";
+
+export default function CookieBanner() {
+  const [open, setOpen] = useState(false);
+
+  useEffect(() => {
+    setOpen(getConsent() === null);
+  }, []);
+
+  if (!open) return null;
+
+  const choose = (value: "granted" | "denied") => {
+    setConsent(value);
+    setOpen(false);
+  };
+
+  return (
+    <div
+      role="dialog"
+      aria-live="polite"
+      aria-label="Cookie consent"
+      className="fixed inset-x-0 bottom-0 z-[60] p-4 md:p-6"
+    >
+      <div className="mx-auto max-w-3xl bg-[#111] text-white border border-white/10 shadow-2xl p-5 md:p-6 flex flex-col md:flex-row md:items-center gap-4">
+        <p className="text-sm text-neutral-300 leading-relaxed flex-1">
+          We use cookies, including the Meta Pixel, to measure and improve our
+          advertising. You can accept or decline. See our{" "}
+          <Link href="/privacy" className="underline underline-offset-4 hover:text-white">
+            Privacy Policy
+          </Link>
+          .
+        </p>
+        <div className="flex gap-3 shrink-0">
+          <button
+            type="button"
+            onClick={() => choose("denied")}
+            className="px-5 py-2.5 text-xs font-bold uppercase tracking-widest border border-white/20 hover:border-white transition-colors"
+          >
+            Decline
+          </button>
+          <button
+            type="button"
+            onClick={() => choose("granted")}
+            className="px-5 py-2.5 text-xs font-bold uppercase tracking-widest bg-red-600 hover:bg-red-700 transition-colors"
+          >
+            Accept
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/app/components/consent/MetaPixel.tsx b/app/components/consent/MetaPixel.tsx
new file mode 100644
index 0000000..5854b82
--- /dev/null
+++ b/app/components/consent/MetaPixel.tsx
@@ -0,0 +1,53 @@
+"use client";
+
+import Script from "next/script";
+import { usePathname } from "next/navigation";
+import { useEffect, useRef, useState } from "react";
+import {
+  CONSENT_EVENT,
+  META_PIXEL_ID,
+  getConsent,
+  type Consent,
+} from "../../lib/pixel";
+
+/**
+ * Loads the Meta Pixel only once the visitor has accepted cookies
+ * (NDPA 2023 / UK GDPR), and records a PageView on every client-side
+ * navigation, not just the first page load.
+ */
+export default function MetaPixel() {
+  const [consent, setConsentState] = useState<Consent | null>(null);
+  const pathname = usePathname();
+  const firstView = useRef(true);
+
+  useEffect(() => {
+    setConsentState(getConsent());
+    const onChange = (e: Event) =>
+      setConsentState((e as CustomEvent<Consent>).detail);
+    window.addEventListener(CONSENT_EVENT, onChange);
+    return () => window.removeEventListener(CONSENT_EVENT, onChange);
+  }, []);
+
+  // The init snippet fires the first PageView; later route changes need one each.
+  useEffect(() => {
+    if (consent !== "granted") return;
+    if (firstView.current) {
+      firstView.current = false;
+      return;
+    }
+    window.fbq?.("track", "PageView");
+  }, [pathname, consent]);
+
+  if (consent !== "granted") return null;
+
+  return (
+    <Script id="meta-pixel" strategy="afterInteractive">{`
+!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
+n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
+n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
+t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
+document,'script','https://connect.facebook.net/en_US/fbevents.js');
+fbq('init','${META_PIXEL_ID}');fbq('track','PageView');
+`}</Script>
+  );
+}
